      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "RiskOps Webhook",
      "webhookId": "a1b2c3d4-0001-4000-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst incident_id = body.incident_id;\nconst service = body.service || body.service_name;\nconst severity = body.severity;\nconst risk_score = body.risk_score !== undefined && body.risk_score !== null ? Number(body.risk_score) : null;\nconst timestamp = body.timestamp;\nconst confidence = body.confidence !== undefined && body.confidence !== null ? Number(body.confidence) : null;\nconst routing_decision = body.routing_decision;\n\n// Minimum required fields per Section 7.5\nconst missing = [];\nif (!incident_id) missing.push('incident_id');\nif (!service) missing.push('service');\nif (!severity) missing.push('severity');\nif (risk_score === null || isNaN(risk_score)) missing.push('risk_score');\nif (!timestamp) missing.push('timestamp');\nif (confidence === null || isNaN(confidence)) missing.push('confidence');\nif (!routing_decision) missing.push('routing_decision');\n\nif (missing.length > 0) {\n  return {\n    json: {\n      valid: false,\n      error: `Validation failed: missing required fields [${missing.join(', ')}]`,\n      incident_id: incident_id || null,\n      service: service || null,\n      status: 'REJECTED_INVALID_PAYLOAD',\n      timestamp: new Date().toISOString()\n    }\n  };\n}\n\nconst status = body.status || (severity === 'CRITICAL' ? 'OPEN' : 'NORMAL');\nconst is_recovery = (body.status === 'RESOLVED') || (severity.toUpperCase() === 'HEALTHY') || (risk_score < 40.0 && body.status === 'RESOLVED');\n\nreturn {\n  json: {\n    valid: true,\n    incident_id,\n    service,\n    severity: severity.toUpperCase(),\n    risk_score,\n    risk_tier: body.risk_tier || severity,\n    predicted_failure: body.predicted_failure || body.predicted_failure_type || 'latency_degradation',\n    anomaly_score: body.anomaly_score !== undefined && body.anomaly_score !== null ? Number(body.anomaly_score) : null,\n    forecast_risk: body.forecast_risk !== undefined && body.forecast_risk !== null ? Number(body.forecast_risk) : null,\n    root_cause: body.root_cause || body.predicted_root_cause_service || service,\n    affected_services: Array.isArray(body.affected_services) ? body.affected_services : [service],\n    confidence,\n    routing_decision,\n    guidance: body.guidance || 'Investigate telemetry anomalies',\n    status,\n    is_recovery,\n    timestamp\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        0
      ],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validate & Parse Incident"
    },
