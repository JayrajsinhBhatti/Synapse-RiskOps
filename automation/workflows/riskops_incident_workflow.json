    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst notification_text = `Synapse RiskOps Incident\\n\\nService: ${item.service}\\nSeverity: ${item.severity}\\nRisk Score: ${item.risk_score}\\nRoot Cause: ${item.root_cause}\\nConfidence: ${item.confidence}\\n\\nRemediation is available.\\n\\nHuman approval required before remediation.`;\n\nreturn {\n  json: {\n    ...item,\n    notification_title: `Synapse RiskOps Incident [${item.severity}]`,\n    notification_message: notification_text,\n    remediation_available: true,\n    human_approval_required: true,\n    approval_status: 'PENDING_HUMAN_APPROVAL',\n    predefined_action: 'REMEDIATE_SERVICE_LATENCY',\n    evaluated_at: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
