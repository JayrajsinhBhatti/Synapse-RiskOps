        "jsCode": "const incoming = $input.item.json;\nconst prev = $('Prepare Auto-Remediation').first().json;\nconst isError = Boolean(incoming.error || incoming.status >= 400 || (incoming.statusCode && incoming.statusCode >= 400));\n\nif (isError) {\n  return {\n    json: {\n      incident_id: prev.incident_id,\n      service_name: prev.service_name,\n      risk_score: prev.risk_score,\n      failure_type: prev.failure_type,\n      target_host: prev.target_host,\n      routing_decision: 'escalate',\n      remediation_status: 'FAILED',\n      error_details: incoming.error || incoming.message || 'Remediation control plane execution failed',\n      timestamp: new Date().toISOString()\n    }\n  };\n}\n\nreturn {\n  json: {\n    incident_id: prev.incident_id,\n    service_name: prev.service_name,\n    risk_score: prev.risk_score,\n    failure_type: prev.failure_type,\n    target_host: prev.target_host,\n    routing_decision: 'auto_remediate',\n    remediation_status: 'SUCCESS',\n    execution_response: incoming,\n    timestamp: new Date().toISOString()\n  }\n};"
