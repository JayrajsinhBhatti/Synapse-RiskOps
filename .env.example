# =====================================================
# Synapse RiskOps - Environment Variables
# Copy to .env and adjust as needed
# =====================================================

# ----- PostgreSQL -----
POSTGRES_DB=synapse_riskops
POSTGRES_USER=synapse_admin
POSTGRES_PASSWORD=synapse_dev_2026
POSTGRES_PORT=5432

# ----- Backend (Spring Boot) -----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/synapse_riskops
SPRING_DATASOURCE_USERNAME=synapse_admin
SPRING_DATASOURCE_PASSWORD=synapse_dev_2026
JWT_SECRET=dev_only_jwt_secret_key_do_not_use_in_production_change_this_immediately_64chars
JWT_EXPIRATION_MS=86400000
ML_ENGINE_URL=http://ml-engine:8000
GENAI_AGENT_URL=http://genai-agent:8001

# ----- ML Engine (FastAPI) -----
ML_ENGINE_HOST=0.0.0.0
ML_ENGINE_PORT=8000
ML_ENGINE_LOG_LEVEL=info
ML_ENGINE_WORKERS=1
ML_ENGINE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ----- GenAI Agent (Person 1) -----
GENAI_AGENT_PORT=8001
GEMINI_API_KEY=

# ----- Frontend (React/Vite) -----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=Synapse RiskOps

# ----- n8n (Person 1, Week 5) -----
N8N_PORT=5678
N8N_WEBHOOK_URL=
