{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatbotMessage",
  "description": "Standard schema for messages, card payloads, and actions exchanged with the Synapse RiskOps Chatbot",
  "type": "object",
  "required": ["id", "sender", "timestamp", "content"],
  "properties": {
    "id": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": ["user", "assistant", "system"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "data"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "risk_score",
              "diagnosis_summary",
              "incident_timeline",
              "remediation_status",
              "blast_radius_tree"
            ]
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "pendingAction": {
      "type": "object",
      "properties": {
        "actionId": { "type": "string" },
        "actionType": { "type": "string" },
        "serviceName": { "type": "string" },
        "description": { "type": "string" },
        "requiresConfirmation": { "type": "boolean" }
      }
    }
  }
}
